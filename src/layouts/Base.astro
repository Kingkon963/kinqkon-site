---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { identity } from '../data/site.ts';

interface Props {
  title?: string;
  description?: string;
  /** Set on article pages so Open Graph reports the right kind. */
  ogType?: 'website' | 'article';
  publishedAt?: Date;
}

const {
  title = `${identity.name}: software engineer building AI agents, automation, and AWS systems`,
  description = 'Md. Naimul Islam Kingkon (Naim) is a software engineer in Dhaka, Bangladesh. He builds AI agents, automation pipelines, and serverless AWS systems that ship to production.',
  ogType = 'website',
  publishedAt,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.fullName,
  alternateName: identity.name,
  url: 'https://kinqkon.com',
  jobTitle: 'Software Engineer',
  description,
  email: `mailto:${identity.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Dhaka',
    addressCountry: 'BD',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Ahsanullah University of Science and Technology',
  },
  knowsLanguage: ['bn', 'en'],
  knowsAbout: [
    'AI agents',
    'Workflow automation',
    'AWS',
    'Serverless architecture',
    'TypeScript',
    'Python',
    'Web scraping',
  ],
  sameAs: [
    'https://github.com/Kingkon963',
    'https://www.linkedin.com/in/naim-kingkon',
    'https://www.upwork.com/freelancers/~014046cecba2ff7614',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="author" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Naim Kingkon, notes"
      href="/notes/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:locale" content="en_GB" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15120e" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <script is:inline>
      // Decide the theme before first paint so the page never flashes.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch (error) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <slot />
    <Footer />
  </body>
</html>
