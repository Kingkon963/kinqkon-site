---
import { colophon, identity, links } from '../data/site.ts';

const built = new Date().toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<footer class="footer">
  <div class="footer__inner">
    <p class="footer__sign">No pitch and no newsletter. If something here was useful, say hello.</p>

    <ul class="footer__links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="footer__note">
      {colophon.map((line) => <p>{line}</p>)}
      <p>
        Written and maintained by {identity.fullName}. This build is dated {built}.
      </p>
    </div>
  </div>
</footer>
